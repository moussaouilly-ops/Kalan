# Django
DJANGO_SECRET_KEY=change-moi-en-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données
# Laisser USE_POSTGRES=False pour démarrer avec SQLite (rien à installer).
# Passer à True + remplir les DB_* ci-dessous quand PostgreSQL sera installé.
USE_POSTGRES=False
DB_NAME=elearning_db
DB_USER=elearning_user
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# Frontend
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# E-mail (SMTP en production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@votre-domaine.com

# --- Paiement mobile money — contrat direct par opérateur ---

# Orange Money : à obtenir via developer.orange.com après souscription à
# l'offre "Web Payment / M Payment" (⚠️ le Burkina Faso n'apparaît pas
# explicitement dans la liste officielle des pays couverts au moment de
# l'écriture de ce fichier — à confirmer avec Orange Money Burkina Faso).
# ORANGE_MONEY_AUTH_HEADER = base64(client_id:client_secret)
ORANGE_MONEY_AUTH_HEADER=
ORANGE_MONEY_MERCHANT_KEY=
ORANGE_MONEY_COUNTRY_CODE=bf

# Wave : à créer sur business.wave.com → Developers (identité + registre de
# commerce requis, 48-72h de validation).
WAVE_API_KEY=

# Moov Money : aucune documentation publique trouvée — contacte Moov Money
# Burkina Faso pour obtenir ces identifiants et leur doc d'intégration.
MOOV_MONEY_BASE_URL=
MOOV_MONEY_MERCHANT_KEY=

# Coris Money : aucune documentation publique trouvée — contacte Coris Bank
# International pour obtenir ces identifiants et leur doc d'intégration.
CORIS_MONEY_BASE_URL=
CORIS_MONEY_MERCHANT_KEY=

# --- PayDunya (agrégateur, optionnel, en secours) ---
# Utile si un contrat direct prend du temps à obtenir. Compte sur
# https://paydunya.com/signup, clés dans "Intégrez notre API".
PAYDUNYA_MASTER_KEY=
PAYDUNYA_PRIVATE_KEY=
PAYDUNYA_PUBLIC_KEY=
PAYDUNYA_TOKEN=
PAYDUNYA_MODE=test
